# ---- API ayarlari ----
PORT=3000
# Token imzalama anahtari: uzun ve rastgele bir deger yazin (uretimde mutlaka degistirin)
JWT_SECRET=buraya-uzun-rastgele-bir-gizli-anahtar-yazin
JWT_EXPIRES_IN=12h

# ---- MSSQL baglanti bilgileri (sirket sunucusu) ----
# Sunucu adresi: IP veya makine adi. Adlandirilmis instance icin: SUNUCU\\SQLEXPRESS
DB_SERVER=192.168.1.10
DB_PORT=1433
DB_NAME=portal_ornekfirma_DB
DB_USER=pdks_user
DB_PASSWORD=BurayaSifreYazin

# Sirket ici sunucular genelde sertifikasizdir; o durumda asagidaki gibi birakin:
DB_ENCRYPT=false
DB_TRUST_CERT=true
