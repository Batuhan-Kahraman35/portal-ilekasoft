<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Velopack güncelleme paketleri -->
      <mimeMap fileExtension=".nupkg" mimeType="application/octet-stream" />
      <!-- Sürüm listesi önbelleğe alınmasın: yeni sürüm anında görünsün -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
